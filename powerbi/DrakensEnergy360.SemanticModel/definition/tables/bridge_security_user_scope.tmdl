table bridge_security_user_scope

	column 'User Principal'
		dataType: string
		sourceColumn: user_principal
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Scope Type'
		dataType: string
		sourceColumn: scope_type
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Scope Value'
		dataType: string
		sourceColumn: scope_value
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Grants Everything'
		dataType: boolean
		sourceColumn: grants_everything
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Dw Loaded At'
		dataType: dateTime
		sourceColumn: dw_loaded_at
		summarizeBy: none
		isHidden
		formatString: yyyy-mm-dd
		annotation SummarizationSetBy = "Automatic"

	partition bridge_security_user_scope = m
		mode: import
		source =
				let
				    Source = Databricks.Catalogs(ServerHostname, HttpPath, null),
				    Catalog = Source{[Name=CatalogName]}[Data],
				    Schema  = Catalog{[Name="gold"]}[Data],
				    Table   = Schema{[Name="bridge_security_user_scope"]}[Data]
				in
				    Table

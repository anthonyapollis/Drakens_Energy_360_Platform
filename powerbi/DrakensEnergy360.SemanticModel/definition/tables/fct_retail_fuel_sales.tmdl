	column 'Cleansed At'
		dataType: dateTime
		sourceColumn: _cleansed_at
		summarizeBy: none
		isHidden
		formatString: yyyy-mm-dd
		annotation SummarizationSetBy = "Automatic"

	partition fct_retail_fuel_sales = m
		mode: import
		source =
				let
				    Path    = DataFolder & "fct_retail_fuel_sales.csv",
				    Source  = Csv.Document(File.Contents(Path), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Chosen  = Table.SelectColumns(Headers, {"transaction_id", "transaction_ts", "date_key", "time_key", "site_key", "product_key", "site_id", "product_id", "province", "city", "country_code", "urban_class", "site_type", "ownership_model", "demand_band", "product_name", "fuel_grade", "reporting_line", "is_regulated_price", "is_unmatched_site", "is_unmatched_product", "pump_number", "forecourt_lane", "shift_name", "payment_method", "loyalty_flag", "loyalty_member_id", "is_fleet_sale", "litres", "gross_sales_zar", "cogs_zar", "gross_margin_zar", "unit_price_zar", "line_margin_pct", "margin_cents_per_litre", "source_system_code", "ingested_at", "_cleansed_at"}),
				    Typed   = Table.TransformColumnTypes(Chosen, {{"transaction_id", type text}, {"transaction_ts", type datetime}, {"date_key", Int64.Type}, {"time_key", Int64.Type}, {"site_key", Int64.Type}, {"product_key", Int64.Type}, {"site_id", type text}, {"product_id", type text}, {"province", type text}, {"city", type text}, {"country_code", type text}, {"urban_class", type text}, {"site_type", type text}, {"ownership_model", type text}, {"demand_band", type text}, {"product_name", type text}, {"fuel_grade", type text}, {"reporting_line", type text}, {"is_regulated_price", type logical}, {"is_unmatched_site", type logical}, {"is_unmatched_product", type logical}, {"pump_number", Int64.Type}, {"forecourt_lane", Int64.Type}, {"shift_name", type text}, {"payment_method", type text}, {"loyalty_flag", type logical}, {"loyalty_member_id", type text}, {"is_fleet_sale", type logical}, {"litres", type number}, {"gross_sales_zar", type number}, {"cogs_zar", type number}, {"gross_margin_zar", type number}, {"unit_price_zar", type number}, {"line_margin_pct", type number}, {"margin_cents_per_litre", type number}, {"source_system_code", type text}, {"ingested_at", type datetime}, {"_cleansed_at", type datetime}})
				in
				    Typed

		annotation SummarizationSetBy = "Automatic"

	column 'Ownership Model'
		dataType: string
		sourceColumn: ownership_model
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Demand Band'
		dataType: string
		sourceColumn: demand_band
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Product Name'
		dataType: string
		sourceColumn: product_name
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Fuel Grade'
		dataType: string
		sourceColumn: fuel_grade
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Reporting Line'
		dataType: string
		sourceColumn: reporting_line
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Is Regulated Price'
		dataType: boolean
		sourceColumn: is_regulated_price
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Is Unmatched Site'
		dataType: boolean
		sourceColumn: is_unmatched_site
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Is Unmatched Product'
		dataType: boolean
		sourceColumn: is_unmatched_product
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Pump Number'
		dataType: int64
		sourceColumn: pump_number
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Forecourt Lane'
		dataType: int64
		sourceColumn: forecourt_lane
		summarizeBy: sum
		annotation SummarizationSetBy = "Automatic"

	column 'Shift Name'
		dataType: string
		sourceColumn: shift_name
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Payment Method'
		dataType: string
		sourceColumn: payment_method
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Loyalty Flag'
		dataType: boolean
		sourceColumn: loyalty_flag
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Loyalty Member ID'
		dataType: string
		sourceColumn: loyalty_member_id
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Is Fleet Sale'
		dataType: boolean
		sourceColumn: is_fleet_sale
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Litres'
		dataType: double
		sourceColumn: litres
		summarizeBy: sum
		annotation SummarizationSetBy = "Automatic"

	column 'Gross Sales (R)'
		dataType: decimal
		sourceColumn: gross_sales_zar
		summarizeBy: sum

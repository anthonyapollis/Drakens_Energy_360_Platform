	column 'Gross Margin (R)'
		dataType: decimal
		sourceColumn: gross_margin_zar
		summarizeBy: sum
		formatString: "R"#,0.00
		annotation SummarizationSetBy = "Automatic"

	column 'Unit Price (R)'
		dataType: double
		sourceColumn: unit_price_zar
		summarizeBy: sum
		formatString: "R"#,0.00
		annotation SummarizationSetBy = "Automatic"

	column 'Line Margin %'
		dataType: double

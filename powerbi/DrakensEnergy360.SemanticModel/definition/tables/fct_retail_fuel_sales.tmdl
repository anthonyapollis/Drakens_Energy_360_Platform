table fct_retail_fuel_sales

	column 'Transaction ID'
		dataType: string
		sourceColumn: transaction_id
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Transaction Timestamp'
		dataType: dateTime
		sourceColumn: transaction_ts
		summarizeBy: none
		formatString: yyyy-mm-dd
		annotation SummarizationSetBy = "Automatic"

	column 'Date Key'
		dataType: int64
		sourceColumn: date_key
		summarizeBy: none
		isHidden
		annotation SummarizationSetBy = "Automatic"

	column 'Time Key'
		dataType: int64
		sourceColumn: time_key
		summarizeBy: none
		isHidden
		annotation SummarizationSetBy = "Automatic"

	column 'Site Key'
		dataType: int64
		sourceColumn: site_key
		summarizeBy: none
		isHidden
		annotation SummarizationSetBy = "Automatic"

	column 'Product Key'
		dataType: int64
		sourceColumn: product_key
		summarizeBy: none
		isHidden
		annotation SummarizationSetBy = "Automatic"

	column 'Site ID'
		dataType: string
		sourceColumn: site_id
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Product ID'
		dataType: string
		sourceColumn: product_id

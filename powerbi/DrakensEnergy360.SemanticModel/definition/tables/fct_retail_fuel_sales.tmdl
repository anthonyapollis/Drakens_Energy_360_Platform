		summarizeBy: none
		dataCategory: Country
		annotation SummarizationSetBy = "Automatic"

	column 'Urban Class'
		dataType: string
		sourceColumn: urban_class
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Site Type'
		dataType: string
		sourceColumn: site_type

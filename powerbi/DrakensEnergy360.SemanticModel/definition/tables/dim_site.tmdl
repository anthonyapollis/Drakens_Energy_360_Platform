table dim_site

	column 'Site Key'
		dataType: int64
		sourceColumn: site_key
		summarizeBy: none
		isHidden
		annotation SummarizationSetBy = "Automatic"

	column 'Site ID'
		dataType: string
		sourceColumn: site_id
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Site Name'
		dataType: string
		sourceColumn: site_name
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Country Code'
		dataType: string
		sourceColumn: country_code
		summarizeBy: none
		dataCategory: Country
		annotation SummarizationSetBy = "Automatic"

	column 'Province'
		dataType: string
		sourceColumn: province
		summarizeBy: none
		dataCategory: StateOrProvince
		annotation SummarizationSetBy = "Automatic"

	column 'City'
		dataType: string
		sourceColumn: city
		summarizeBy: none
		dataCategory: City
		annotation SummarizationSetBy = "Automatic"

	column 'Urban Class'
		dataType: string
		sourceColumn: urban_class
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Site Type'
		dataType: string
		sourceColumn: site_type
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Ownership Model'
		dataType: string
		sourceColumn: ownership_model
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Site Status'
		dataType: string
		sourceColumn: site_status
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Latitude'
		dataType: double
		sourceColumn: latitude
		summarizeBy: none
		dataCategory: Latitude
		annotation SummarizationSetBy = "Automatic"

	column 'Longitude'
		dataType: double
		sourceColumn: longitude
		summarizeBy: none
		dataCategory: Longitude
		annotation SummarizationSetBy = "Automatic"

	column 'On National Route'
		dataType: boolean
		sourceColumn: on_national_route
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Forecourt Lanes'
		dataType: int64
		sourceColumn: forecourt_lanes
		summarizeBy: sum
		annotation SummarizationSetBy = "Automatic"

	column 'Has Convenience'
		dataType: boolean
		sourceColumn: has_convenience
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Has QSR'
		dataType: boolean
		sourceColumn: has_qsr
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Has Car Wash'
		dataType: boolean
		sourceColumn: has_car_wash
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Has EV Charging'
		dataType: boolean
		sourceColumn: has_ev_charging
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Has Solar'
		dataType: boolean
		sourceColumn: has_solar
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Has LPG'
		dataType: boolean
		sourceColumn: has_lpg
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Is 24 Hour'
		dataType: boolean
		sourceColumn: is_24_hour
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Opened Date'
		dataType: dateTime
		sourceColumn: opened_date
		summarizeBy: none
		formatString: yyyy-mm-dd
		annotation SummarizationSetBy = "Automatic"

	column 'Demand Index'
		dataType: double
		sourceColumn: demand_index
		summarizeBy: sum
		annotation SummarizationSetBy = "Automatic"

	column 'Demand Band'
		dataType: string
		sourceColumn: demand_band
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Offer Tier'
		dataType: string
		sourceColumn: offer_tier
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'New Energy Profile'
		dataType: string
		sourceColumn: new_energy_profile
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Site Age Years'
		dataType: double
		sourceColumn: site_age_years
		summarizeBy: sum
		annotation SummarizationSetBy = "Automatic"

	column 'Is South Africa'
		dataType: boolean
		sourceColumn: is_south_africa
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Effective From Date'
		dataType: dateTime
		sourceColumn: effective_from_date
		summarizeBy: none
		formatString: yyyy-mm-dd
		annotation SummarizationSetBy = "Automatic"

	column 'Effective To Date'
		dataType: dateTime
		sourceColumn: effective_to_date
		summarizeBy: none
		formatString: yyyy-mm-dd
		annotation SummarizationSetBy = "Automatic"

	column 'Is Current'
		dataType: boolean
		sourceColumn: is_current
		summarizeBy: none
		annotation SummarizationSetBy = "Automatic"

	column 'Scd Version'
		dataType: int64
		sourceColumn: scd_version
		summarizeBy: sum
		isHidden
		annotation SummarizationSetBy = "Automatic"

	column 'Dw Hash Diff'
		dataType: string
		sourceColumn: dw_hash_diff
		summarizeBy: none
		isHidden
		annotation SummarizationSetBy = "Automatic"

	column 'Record Source'
		dataType: string
		sourceColumn: record_source
		summarizeBy: none
		isHidden
		annotation SummarizationSetBy = "Automatic"

	partition dim_site = m
		mode: import
		source =
				let
				    Source = Databricks.Catalogs(ServerHostname, HttpPath, null),
				    Catalog = Source{[Name=CatalogName]}[Data],
				    Schema  = Catalog{[Name="gold"]}[Data],
				    Table   = Schema{[Name="dim_site"]}[Data]
				in
				    Table

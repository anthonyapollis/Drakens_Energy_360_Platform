            "summarizeBy": "sum"
          },
          {
            "name": "Cash Sales (R)",
            "dataType": "decimal",
            "sourceColumn": "cash_sales_zar",
            "summarizeBy": "sum",
            "formatString": "\"R\"#,0.00"
          },
          {
            "name": "Gross Margin % (row)",
            "dataType": "double",
            "sourceColumn": "gross_margin_pct",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0.0%"
          },
          {
            "name": "Litres Per Transaction",
            "dataType": "double",
            "sourceColumn": "litres_per_transaction",
            "summarizeBy": "sum"
          },
          {
            "name": "Average Transaction (R)",
            "dataType": "double",
            "sourceColumn": "average_transaction_zar",
            "summarizeBy": "sum",
            "formatString": "\"R\"#,0.00"
          },
          {
            "name": "Loyalty Penetration %",
            "dataType": "double",
            "sourceColumn": "loyalty_penetration_pct",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "Diesel Share %",
            "dataType": "double",
            "sourceColumn": "diesel_share_pct",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "Full Date",
            "dataType": "dateTime",
            "sourceColumn": "full_date",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "Day Name",
            "dataType": "string",
            "sourceColumn": "day_name",
            "summarizeBy": "none"
          },
          {
            "name": "Month Name",
            "dataType": "string",
            "sourceColumn": "month_name",
            "summarizeBy": "none"
          },
          {
            "name": "Calendar Year",
            "dataType": "int64",
            "sourceColumn": "calendar_year",
            "summarizeBy": "none"
          },
          {
            "name": "Fiscal Year",
            "dataType": "int64",
            "sourceColumn": "fiscal_year",
            "summarizeBy": "none"
          },
          {
            "name": "Is Weekend",
            "dataType": "boolean",
            "sourceColumn": "is_weekend",
            "summarizeBy": "none"
          },
          {
            "name": "Is Public Holiday ZA",
            "dataType": "boolean",
            "sourceColumn": "is_public_holiday_za",
            "summarizeBy": "none"
          },
          {
            "name": "Season Southern",
            "dataType": "string",
            "sourceColumn": "season_southern",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Fuel Volume (L)",
            "expression": "SUM ( agg_site_daily_fuel[Litres] )",
            "formatString": "#,0",
            "displayFolder": "Volume"
          },
          {
            "name": "Volume per Site (L)",
            "expression": "DIVIDE ( [Fuel Volume (L)], [Trading Sites] )",
            "formatString": "#,0",
            "displayFolder": "Volume"
          },
          {
            "name": "Trading Sites",
            "expression": "DISTINCTCOUNT ( agg_site_daily_fuel[Site Key] )",
            "formatString": "#,0",
            "displayFolder": "Volume"
          },
          {
            "name": "Fuel Revenue",
            "expression": "SUM ( agg_site_daily_fuel[Gross Sales (R)] )",
            "formatString": "\"R\"#,0",
            "displayFolder": "Value"
          },
          {
            "name": "Gross Margin",
            "expression": "SUM ( agg_site_daily_fuel[Gross Margin (R)] )",
            "formatString": "\"R\"#,0",
            "displayFolder": "Value"
          },
          {
            "name": "Gross Margin %",
            "expression": "DIVIDE ( [Gross Margin], [Fuel Revenue] )",
            "formatString": "0.0%",
            "displayFolder": "Value"
          },
          {
            "name": "Margin per Litre (c)",
            "expression": "DIVIDE ( [Gross Margin], [Fuel Volume (L)] ) * 100",
            "formatString": "#,0.0",
            "displayFolder": "Value"
          },
          {
            "name": "Transaction Count",
            "expression": "SUM ( agg_site_daily_fuel[Transaction Count (row)] )",
            "formatString": "#,0",
            "displayFolder": "Volume"
          },
          {
            "name": "Average Transaction Value",
            "expression": "DIVIDE ( [Fuel Revenue], [Transaction Count] )",
            "formatString": "\"R\"#,0.00",
            "displayFolder": "Value"
          },
          {
            "name": "Fuel Volume LY",
            "expression": "CALCULATE ( [Fuel Volume (L)], SAMEPERIODLASTYEAR ( dim_date[Full Date] ) )",
            "formatString": "#,0",
            "displayFolder": "Time"
          },
          {
            "name": "Fuel Volume YoY %",
            "expression": "DIVIDE ( [Fuel Volume (L)] - [Fuel Volume LY], [Fuel Volume LY] )",
            "formatString": "0.0%",
            "displayFolder": "Time"
          },
          {
            "name": "Gross Margin YTD",
            "expression": "TOTALYTD ( [Gross Margin], dim_date[Full Date] )",
            "formatString": "\"R\"#,0",
            "displayFolder": "Time"
          },
          {
            "name": "Fuel Volume 7D Average",
            "expression": "AVERAGEX ( DATESINPERIOD ( dim_date[Full Date], MAX ( dim_date[Full Date] ), -7, DAY ), [Fuel Volume (L)] )",
            "formatString": "#,0",
            "displayFolder": "Time"
          },
          {
            "name": "Fuel Revenue LY",
            "expression": "CALCULATE ( [Fuel Revenue], SAMEPERIODLASTYEAR ( dim_date[Full Date] ) )",
            "formatString": "\"R\"#,0",
            "displayFolder": "Time"
          },
          {
            "name": "Fuel Revenue YoY %",
            "expression": "DIVIDE ( [Fuel Revenue] - [Fuel Revenue LY], [Fuel Revenue LY] )",
            "formatString": "0.0%",
            "displayFolder": "Time"
          },
          {
            "name": "Gross Margin LY",
            "expression": "CALCULATE ( [Gross Margin], SAMEPERIODLASTYEAR ( dim_date[Full Date] ) )",
            "formatString": "\"R\"#,0",
            "displayFolder": "Time"
          },
          {
            "name": "Gross Margin YoY %",
            "expression": "DIVIDE ( [Gross Margin] - [Gross Margin LY], [Gross Margin LY] )",
            "formatString": "0.0%",
            "displayFolder": "Time"
          },
          {
            "name": "Margin per Litre LY (c)",
            "expression": "CALCULATE ( [Margin per Litre (c)], SAMEPERIODLASTYEAR ( dim_date[Full Date] ) )",
            "formatString": "#,0.0",
            "displayFolder": "Time"
          },
          {
            "name": "Average Daily Volume (L)",
            "expression": "AVERAGEX ( VALUES ( dim_date[Full Date] ), [Fuel Volume (L)] )",
            "formatString": "#,0",
            "displayFolder": "Averages"
          },
          {
            "name": "Average Weekly Volume (L)",
            "expression": "AVERAGEX ( SUMMARIZE ( dim_date, dim_date[Calendar Year], dim_date[Week Of Year] ), [Fuel Volume (L)] )",
            "formatString": "#,0",
            "displayFolder": "Averages"
          },
          {
            "name": "Average Yearly Volume (L)",
            "expression": "AVERAGEX ( VALUES ( dim_date[Calendar Year] ), [Fuel Volume (L)] )",
            "formatString": "#,0",
            "displayFolder": "Averages"
          },
          {
            "name": "Average Monthly Volume (L)",
            "expression": "AVERAGEX ( VALUES ( dim_date[Year Month] ), [Fuel Volume (L)] )",
            "formatString": "#,0",
            "displayFolder": "Averages"
          },
          {
            "name": "Average Monthly Margin",
            "expression": "AVERAGEX ( VALUES ( dim_date[Year Month] ), [Gross Margin] )",
            "formatString": "\"R\"#,0",
            "displayFolder": "Averages"
          },
          {
            "name": "Average Daily Margin",
            "expression": "AVERAGEX ( VALUES ( dim_date[Full Date] ), [Gross Margin] )",
            "formatString": "\"R\"#,0",
            "displayFolder": "Averages"
          },
          {
            "name": "Fuel Volume 30D Average",
            "expression": "AVERAGEX ( DATESINPERIOD ( dim_date[Full Date], MAX ( dim_date[Full Date] ), -30, DAY ), [Fuel Volume (L)] )",
            "formatString": "#,0",
            "displayFolder": "Time"
          },
          {
            "name": "Margin 30D Average",
            "expression": "AVERAGEX ( DATESINPERIOD ( dim_date[Full Date], MAX ( dim_date[Full Date] ), -30, DAY ), [Gross Margin] )",
            "formatString": "\"R\"#,0",
            "displayFolder": "Time"
          },
          {
            "name": "Margin per Site",
            "expression": "DIVIDE ( [Gross Margin], DISTINCTCOUNT ( dim_site[Site Key] ) )",
            "formatString": "\"R\"#,0",
            "displayFolder": "Network"
          }
        ],
        "partitions": [
          {
            "name": "agg_site_daily_fuel",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Path    = DataFolder & \"agg_site_daily_fuel.csv\",",
                "    Source  = Csv.Document(File.Contents(Path), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Chosen  = Table.SelectColumns(Headers, {\"date_key\", \"site_key\", \"site_id\", \"province\", \"urban_class\", \"site_type\", \"demand_band\", \"transaction_count\", \"grades_sold\", \"litres\", \"gross_sales_zar\", \"cogs_zar\", \"gross_margin_zar\", \"diesel_litres\", \"petrol_litres\", \"loyalty_transactions\", \"fleet_transactions\", \"cash_sales_zar\", \"gross_margin_pct\", \"litres_per_transaction\", \"average_transaction_zar\", \"loyalty_penetration_pct\", \"diesel_share_pct\", \"full_date\", \"day_name\", \"month_name\", \"calendar_year\", \"fiscal_year\", \"is_weekend\", \"is_public_holiday_za\", \"season_southern\"}),",
                "    Typed   = Table.TransformColumnTypes(Chosen, {{\"date_key\", Int64.Type}, {\"site_key\", Int64.Type}, {\"site_id\", type text}, {\"province\", type text}, {\"urban_class\", type text}, {\"site_type\", type text}, {\"demand_band\", type text}, {\"transaction_count\", Int64.Type}, {\"grades_sold\", Int64.Type}, {\"litres\", type number}, {\"gross_sales_zar\", type number}, {\"cogs_zar\", type number}, {\"gross_margin_zar\", type number}, {\"diesel_litres\", type number}, {\"petrol_litres\", type number}, {\"loyalty_transactions\", Int64.Type}, {\"fleet_transactions\", Int64.Type}, {\"cash_sales_zar\", type number}, {\"gross_margin_pct\", type number}, {\"litres_per_transaction\", type number}, {\"average_transaction_zar\", type number}, {\"loyalty_penetration_pct\", type number}, {\"diesel_share_pct\", type number}, {\"full_date\", type datetime}, {\"day_name\", type text}, {\"month_name\", type text}, {\"calendar_year\", Int64.Type}, {\"fiscal_year\", Int64.Type}, {\"is_weekend\", type logical}, {\"is_public_holiday_za\", type logical}, {\"season_southern\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },

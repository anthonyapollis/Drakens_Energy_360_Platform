      {
        "name": "obs_ml_product_forecast_12m",
        "columns": [
          {
            "name": "Product Name",
            "dataType": "string",
            "sourceColumn": "product_name",
            "summarizeBy": "none"
          },
          {
            "name": "Reporting Line",
            "dataType": "string",
            "sourceColumn": "reporting_line",
            "summarizeBy": "none"
          },
          {
            "name": "Months Tested",
            "dataType": "int64",
            "sourceColumn": "months_tested",
            "summarizeBy": "sum"
          },
          {
            "name": "Mean Monthly Revenue (R)",
            "dataType": "double",
            "sourceColumn": "mean_monthly_revenue_zar",
            "summarizeBy": "sum",
            "formatString": "\"R\"#,0.00"
          },
          {
            "name": "Mae (R)",
            "dataType": "double",
            "sourceColumn": "mae_zar",
            "summarizeBy": "sum",
            "formatString": "\"R\"#,0.00"
          },
          {
            "name": "Mape",
            "dataType": "double",
            "sourceColumn": "mape",
            "summarizeBy": "sum"
          },
          {
            "name": "Naive Mae (R)",
            "dataType": "double",
            "sourceColumn": "naive_mae_zar",
            "summarizeBy": "sum",
            "formatString": "\"R\"#,0.00"
          },
          {
            "name": "Improvement %",
            "dataType": "double",
            "sourceColumn": "improvement_pct",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "Verdict",
            "dataType": "string",
            "sourceColumn": "verdict",
            "summarizeBy": "none"
          },
          {
            "name": "Disclaimer",
            "dataType": "string",
            "sourceColumn": "disclaimer",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Products Forecast",
            "expression": "COUNTROWS ( obs_ml_product_forecast_12m )",
            "formatString": "#,0",
            "displayFolder": "Forecast"
          },
          {
            "name": "Products Beating Naive (12m)",
            "expression": "CALCULATE ( COUNTROWS ( obs_ml_product_forecast_12m ), obs_ml_product_forecast_12m[Verdict] = \"Beats seasonal-naive\" )",
            "formatString": "#,0",
            "displayFolder": "Forecast"
          },
          {
            "name": "Forecast MAPE (12m)",
            "expression": "AVERAGE ( obs_ml_product_forecast_12m[Mape] )",
            "formatString": "0.0%",
            "displayFolder": "Forecast"
          },
          {
            "name": "Forecast Improvement % (12m)",
            "expression": "DIVIDE ( SUM ( obs_ml_product_forecast_12m[Naive Mae (R)] ) - SUM ( obs_ml_product_forecast_12m[Mae (R)] ), SUM ( obs_ml_product_forecast_12m[Naive Mae (R)] ) )",
            "formatString": "0.0%",
            "displayFolder": "Forecast"
          }
        ],
        "partitions": [
          {
            "name": "obs_ml_product_forecast_12m",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Path    = DataFolder & \"obs_ml_product_forecast_12m.csv\",",
                "    Source  = Csv.Document(File.Contents(Path), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Chosen  = Table.SelectColumns(Headers, {\"product_name\", \"reporting_line\", \"months_tested\", \"mean_monthly_revenue_zar\", \"mae_zar\", \"mape\", \"naive_mae_zar\", \"improvement_pct\", \"verdict\", \"disclaimer\"}),",
                "    Typed   = Table.TransformColumnTypes(Chosen, {{\"product_name\", type text}, {\"reporting_line\", type text}, {\"months_tested\", Int64.Type}, {\"mean_monthly_revenue_zar\", type number}, {\"mae_zar\", type number}, {\"mape\", type number}, {\"naive_mae_zar\", type number}, {\"improvement_pct\", type number}, {\"verdict\", type text}, {\"disclaimer\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "fct_product_revenue_forecast_12m",
        "columns": [
          {
            "name": "Product Name",
            "dataType": "string",
            "sourceColumn": "product_name",
            "summarizeBy": "none"
          },
          {
            "name": "Reporting Line",
            "dataType": "string",
            "sourceColumn": "reporting_line",
            "summarizeBy": "none"
          },
          {
            "name": "Month Start",
            "dataType": "dateTime",
            "sourceColumn": "month_start",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "Horizon",
            "dataType": "int64",
            "sourceColumn": "horizon",
            "summarizeBy": "sum"
          },
          {
            "name": "Actual (R)",
            "dataType": "double",
            "sourceColumn": "actual_zar",
            "summarizeBy": "sum",
            "formatString": "\"R\"#,0.00"
          },
          {
            "name": "Forecast (R)",
            "dataType": "double",
            "sourceColumn": "forecast_zar",
            "summarizeBy": "sum",
            "formatString": "\"R\"#,0.00"
          },
          {
            "name": "Naive (R)",
            "dataType": "double",
            "sourceColumn": "naive_zar",
            "summarizeBy": "sum",
            "formatString": "\"R\"#,0.00"
          },
          {
            "name": "Is Forecast",
            "dataType": "boolean",
            "sourceColumn": "is_forecast",
            "summarizeBy": "none"
          },
          {
            "name": "Abs Error (R)",
            "dataType": "double",
            "sourceColumn": "abs_error_zar",
            "summarizeBy": "sum",
            "formatString": "\"R\"#,0.00"
          },
          {
            "name": "Disclaimer",
            "dataType": "string",
            "sourceColumn": "disclaimer",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Forecast Revenue",
            "expression": "SUM ( fct_product_revenue_forecast_12m[Forecast (R)] )",
            "formatString": "\"R\"#,0",
            "displayFolder": "Forecast"
          },
          {
            "name": "Actual Revenue",
            "expression": "SUM ( fct_product_revenue_forecast_12m[Actual (R)] )",
            "formatString": "\"R\"#,0",
            "displayFolder": "Forecast"
          },
          {
            "name": "Seasonal-Naive Revenue",
            "expression": "SUM ( fct_product_revenue_forecast_12m[Naive (R)] )",
            "formatString": "\"R\"#,0",
            "displayFolder": "Forecast"
          },
          {
            "name": "Next 12 Months Revenue",
            "expression": "CALCULATE ( [Forecast Revenue], fct_product_revenue_forecast_12m[Is Forecast] = TRUE )",
            "formatString": "\"R\"#,0",
            "displayFolder": "Forecast"
          },
          {
            "name": "Backtest Error %",
            "expression": "DIVIDE ( CALCULATE ( SUM ( fct_product_revenue_forecast_12m[Abs Error (R)] ), fct_product_revenue_forecast_12m[Is Forecast] = FALSE ), CALCULATE ( [Actual Revenue], fct_product_revenue_forecast_12m[Is Forecast] = FALSE ) )",
            "formatString": "0.0%",
            "displayFolder": "Forecast"
          }
        ],
        "partitions": [
          {
            "name": "fct_product_revenue_forecast_12m",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Path    = DataFolder & \"fct_product_revenue_forecast_12m.csv\",",
                "    Source  = Csv.Document(File.Contents(Path), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Chosen  = Table.SelectColumns(Headers, {\"product_name\", \"reporting_line\", \"month_start\", \"horizon\", \"actual_zar\", \"forecast_zar\", \"naive_zar\", \"is_forecast\", \"abs_error_zar\", \"disclaimer\"}),",
                "    Typed   = Table.TransformColumnTypes(Chosen, {{\"product_name\", type text}, {\"reporting_line\", type text}, {\"month_start\", type datetime}, {\"horizon\", Int64.Type}, {\"actual_zar\", type number}, {\"forecast_zar\", type number}, {\"naive_zar\", type number}, {\"is_forecast\", type logical}, {\"abs_error_zar\", type number}, {\"disclaimer\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "obs_geo_site_analysis",
        "columns": [
          {
            "name": "Site Key",
            "dataType": "int64",
            "sourceColumn": "site_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Site ID",
            "dataType": "string",
            "sourceColumn": "site_id",
            "summarizeBy": "none"
          },
          {
            "name": "Site Name",
            "dataType": "string",
            "sourceColumn": "site_name",
            "summarizeBy": "none"
          },
          {
            "name": "Country Code",
            "dataType": "string",
            "sourceColumn": "country_code",
            "summarizeBy": "none",
            "dataCategory": "Country"
          },
          {
            "name": "Recorded Province",
            "dataType": "string",
            "sourceColumn": "recorded_province",
            "summarizeBy": "none"
          },
          {
            "name": "Boundary Province",
            "dataType": "string",
            "sourceColumn": "boundary_province",
            "summarizeBy": "none"
          },
          {
            "name": "City",
            "dataType": "string",
            "sourceColumn": "city",
            "summarizeBy": "none",
            "dataCategory": "City"
          },
          {
            "name": "Urban Class",
            "dataType": "string",
            "sourceColumn": "urban_class",
            "summarizeBy": "none"
          },
          {
            "name": "Site Type",
            "dataType": "string",
            "sourceColumn": "site_type",
            "summarizeBy": "none"
          },
          {
            "name": "On National Route",
            "dataType": "boolean",
            "sourceColumn": "on_national_route",
            "summarizeBy": "none"
          },
          {
            "name": "Latitude",
            "dataType": "double",
            "sourceColumn": "latitude",
            "summarizeBy": "none",
            "dataCategory": "Latitude"
          },
          {
            "name": "Longitude",
            "dataType": "double",
            "sourceColumn": "longitude",
            "summarizeBy": "none",
            "dataCategory": "Longitude"
          },
          {
            "name": "Province Check",
            "dataType": "string",
            "sourceColumn": "province_check",
            "summarizeBy": "none"
          },
          {
            "name": "Nearest Site M",
            "dataType": "double",
            "sourceColumn": "nearest_site_m",
            "summarizeBy": "sum"
          },
          {
            "name": "Nearest Site km",
            "dataType": "double",
            "sourceColumn": "nearest_site_km",
            "summarizeBy": "sum"
          },
          {
            "name": "Sites Within 5km",
            "dataType": "int64",
            "sourceColumn": "sites_within_5km",
            "summarizeBy": "sum"
          },
          {
            "name": "Sites Within 25km",
            "dataType": "int64",
            "sourceColumn": "sites_within_25km",
            "summarizeBy": "sum"
          },
          {
            "name": "Proximity Band",
            "dataType": "string",
            "sourceColumn": "proximity_band",
            "summarizeBy": "none"
          },
          {
            "name": "Disclaimer",
            "dataType": "string",
            "sourceColumn": "disclaimer",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Sites Located",
            "expression": "COUNTROWS ( obs_geo_site_analysis )",
            "formatString": "#,0",
            "displayFolder": "Geography"
          },
          {
            "name": "Province Mismatches",
            "expression": "CALCULATE ( COUNTROWS ( obs_geo_site_analysis ), obs_geo_site_analysis[Province Check] = \"Province mismatch\" )",
            "formatString": "#,0",
            "displayFolder": "Geography"
          },
          {
            "name": "Sites Outside Any Boundary",
            "expression": "CALCULATE ( COUNTROWS ( obs_geo_site_analysis ), obs_geo_site_analysis[Province Check] = \"Outside every boundary\" )",
            "formatString": "#,0",
            "displayFolder": "Geography"
          },
          {
            "name": "Geocoding Pass Rate %",
            "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( obs_geo_site_analysis ), obs_geo_site_analysis[Province Check] = \"Matches\" ), CALCULATE ( COUNTROWS ( obs_geo_site_analysis ), obs_geo_site_analysis[Country Code] = \"ZA\" ) )",
            "formatString": "0.0%",
            "displayFolder": "Geography"
          },
          {
            "name": "Median Nearest Site (km)",
            "expression": "MEDIAN ( obs_geo_site_analysis[Nearest Site km] )",
            "formatString": "#,0.0",
            "displayFolder": "Geography"
          },
          {
            "name": "Overlapping Sites",
            "expression": "CALCULATE ( COUNTROWS ( obs_geo_site_analysis ), obs_geo_site_analysis[Proximity Band] = \"Overlapping (under 1 km)\" )",
            "formatString": "#,0",
            "displayFolder": "Geography"
          },
          {
            "name": "Isolated Sites",
            "expression": "CALCULATE ( COUNTROWS ( obs_geo_site_analysis ), obs_geo_site_analysis[Proximity Band] = \"Isolated\" )",
            "formatString": "#,0",
            "displayFolder": "Geography"
          },
          {
            "name": "Geo Latitude",
            "expression": "AVERAGE ( obs_geo_site_analysis[Latitude] )",
            "formatString": "0.000",
            "displayFolder": "Geography"
          },
          {
            "name": "Geo Longitude",
            "expression": "AVERAGE ( obs_geo_site_analysis[Longitude] )",
            "formatString": "0.000",
            "displayFolder": "Geography"
          },
          {
            "name": "Average Sites Within 25km",
            "expression": "AVERAGE ( obs_geo_site_analysis[Sites Within 25km] )",
            "formatString": "#,0.0",
            "displayFolder": "Geography"
          }
        ],
        "partitions": [
          {
            "name": "obs_geo_site_analysis",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Path    = DataFolder & \"obs_geo_site_analysis.csv\",",
                "    Source  = Csv.Document(File.Contents(Path), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Chosen  = Table.SelectColumns(Headers, {\"site_key\", \"site_id\", \"site_name\", \"country_code\", \"recorded_province\", \"boundary_province\", \"city\", \"urban_class\", \"site_type\", \"on_national_route\", \"latitude\", \"longitude\", \"province_check\", \"nearest_site_m\", \"nearest_site_km\", \"sites_within_5km\", \"sites_within_25km\", \"proximity_band\", \"disclaimer\"}),",
                "    Typed   = Table.TransformColumnTypes(Chosen, {{\"site_key\", Int64.Type}, {\"site_id\", type text}, {\"site_name\", type text}, {\"country_code\", type text}, {\"recorded_province\", type text}, {\"boundary_province\", type text}, {\"city\", type text}, {\"urban_class\", type text}, {\"site_type\", type text}, {\"on_national_route\", type logical}, {\"latitude\", type number}, {\"longitude\", type number}, {\"province_check\", type text}, {\"nearest_site_m\", type number}, {\"nearest_site_km\", type number}, {\"sites_within_5km\", Int64.Type}, {\"sites_within_25km\", Int64.Type}, {\"proximity_band\", type text}, {\"disclaimer\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "obs_ml_product_performance",
        "columns": [
          {
            "name": "Product Name",
            "dataType": "string",
            "sourceColumn": "product_name",
            "summarizeBy": "none"
          },
          {
            "name": "Reporting Line",
            "dataType": "string",
            "sourceColumn": "reporting_line",
            "summarizeBy": "none"
          },
          {
            "name": "Fuel Grade",
            "dataType": "string",
            "sourceColumn": "fuel_grade",
            "summarizeBy": "none"
          },
          {
            "name": "Is Regulated Price",
            "dataType": "boolean",
            "sourceColumn": "is_regulated_price",
            "summarizeBy": "none"
          },
          {
            "name": "Test Days",
            "dataType": "int64",
            "sourceColumn": "test_days",
            "summarizeBy": "none"
          },
          {
            "name": "Mean Daily Litres",
            "dataType": "double",
            "sourceColumn": "mean_daily_litres",
            "summarizeBy": "sum"
          },
          {
            "name": "Mae",
            "dataType": "double",
            "sourceColumn": "mae",
            "summarizeBy": "sum"
          },
          {
            "name": "Mape",
            "dataType": "double",
            "sourceColumn": "mape",
            "summarizeBy": "sum"
          },
          {
            "name": "Baseline Mae",
            "dataType": "double",
            "sourceColumn": "baseline_mae",
            "summarizeBy": "sum"
          },
          {
            "name": "Mae Improvement %",
            "dataType": "double",
            "sourceColumn": "mae_improvement_pct",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "R2",
            "dataType": "double",
            "sourceColumn": "r2",
            "summarizeBy": "sum"
          },
          {
            "name": "Verdict",
            "dataType": "string",
            "sourceColumn": "verdict",
            "summarizeBy": "none"
          },
          {
            "name": "Disclaimer",
            "dataType": "string",
            "sourceColumn": "disclaimer",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Products Modelled",
            "expression": "COUNTROWS ( obs_ml_product_performance )",
            "formatString": "#,0",
            "displayFolder": "Machine learning"
          },
          {
            "name": "Products Beating Naive",
            "expression": "CALCULATE ( COUNTROWS ( obs_ml_product_performance ), obs_ml_product_performance[Verdict] = \"Beats seasonal-naive\" )",
            "formatString": "#,0",
            "displayFolder": "Machine learning"
          },
          {
            "name": "Forecast MAE (L)",
            "expression": "AVERAGE ( obs_ml_product_performance[Mae] )",
            "formatString": "#,0",
            "displayFolder": "Machine learning"
          },
          {
            "name": "Naive MAE (L)",
            "expression": "AVERAGE ( obs_ml_product_performance[Baseline Mae] )",
            "formatString": "#,0",
            "displayFolder": "Machine learning"
          },
          {
            "name": "Forecast Improvement %",
            "expression": "DIVIDE ( [Naive MAE (L)] - [Forecast MAE (L)], [Naive MAE (L)] )",
            "formatString": "0.0%",
            "displayFolder": "Machine learning"
          },
          {
            "name": "Forecast MAPE %",
            "expression": "AVERAGE ( obs_ml_product_performance[Mape] )",
            "formatString": "0.0%",
            "displayFolder": "Machine learning"
          }
        ],
        "partitions": [
          {
            "name": "obs_ml_product_performance",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Path    = DataFolder & \"obs_ml_product_performance.csv\",",
                "    Source  = Csv.Document(File.Contents(Path), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Chosen  = Table.SelectColumns(Headers, {\"product_name\", \"reporting_line\", \"fuel_grade\", \"is_regulated_price\", \"test_days\", \"mean_daily_litres\", \"mae\", \"mape\", \"baseline_mae\", \"mae_improvement_pct\", \"r2\", \"verdict\", \"disclaimer\"}),",
                "    Typed   = Table.TransformColumnTypes(Chosen, {{\"product_name\", type text}, {\"reporting_line\", type text}, {\"fuel_grade\", type text}, {\"is_regulated_price\", type logical}, {\"test_days\", Int64.Type}, {\"mean_daily_litres\", type number}, {\"mae\", type number}, {\"mape\", type number}, {\"baseline_mae\", type number}, {\"mae_improvement_pct\", type number}, {\"r2\", type number}, {\"verdict\", type text}, {\"disclaimer\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "fct_product_demand_forecast",
        "columns": [
          {
            "name": "Full Date",
            "dataType": "dateTime",
            "sourceColumn": "full_date",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "Product Name",
            "dataType": "string",
            "sourceColumn": "product_name",
            "summarizeBy": "none"
          },
          {
            "name": "Reporting Line",
            "dataType": "string",
            "sourceColumn": "reporting_line",
            "summarizeBy": "none"
          },
          {
            "name": "Fuel Grade",
            "dataType": "string",
            "sourceColumn": "fuel_grade",
            "summarizeBy": "none"
          },
          {
            "name": "Actual Litres (row)",
            "dataType": "double",
            "sourceColumn": "actual_litres",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
            "name": "Forecast Litres (row)",
            "dataType": "double",
            "sourceColumn": "forecast_litres",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
            "name": "Naive Litres",
            "dataType": "double",
            "sourceColumn": "naive_litres",
            "summarizeBy": "sum"
          },
          {
            "name": "Margin Cents Per Litre",
            "dataType": "double",
            "sourceColumn": "margin_cents_per_litre",
            "summarizeBy": "sum"
          },
          {
            "name": "Avg Unit Price (R)",
            "dataType": "double",
            "sourceColumn": "avg_unit_price_zar",
            "summarizeBy": "sum",
            "formatString": "\"R\"#,0.00"
          },
          {
            "name": "Abs Error Litres",
            "dataType": "double",
            "sourceColumn": "abs_error_litres",
            "summarizeBy": "sum"
          }
        ],
        "measures": [
          {
            "name": "Actual Litres",
            "expression": "SUM ( fct_product_demand_forecast[Actual Litres (row)] )",
            "formatString": "#,0",
            "displayFolder": "Machine learning"
          },
          {
            "name": "Forecast Litres",
            "expression": "SUM ( fct_product_demand_forecast[Forecast Litres (row)] )",
            "formatString": "#,0",
            "displayFolder": "Machine learning"
          },
          {
            "name": "Seasonal-Naive Litres",
            "expression": "SUM ( fct_product_demand_forecast[Naive Litres] )",
            "formatString": "#,0",
            "displayFolder": "Machine learning"
          },
          {
            "name": "Forecast Error (L)",
            "expression": "SUM ( fct_product_demand_forecast[Abs Error Litres] )",
            "formatString": "#,0",
            "displayFolder": "Machine learning"
          },
          {
            "name": "Forecast Error %",
            "expression": "DIVIDE ( [Forecast Error (L)], [Actual Litres] )",
            "formatString": "0.0%",
            "displayFolder": "Machine learning"
          }
        ],
        "partitions": [
          {
            "name": "fct_product_demand_forecast",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Path    = DataFolder & \"fct_product_demand_forecast.csv\",",
                "    Source  = Csv.Document(File.Contents(Path), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Chosen  = Table.SelectColumns(Headers, {\"full_date\", \"product_name\", \"reporting_line\", \"fuel_grade\", \"actual_litres\", \"forecast_litres\", \"naive_litres\", \"margin_cents_per_litre\", \"avg_unit_price_zar\", \"abs_error_litres\"}),",
                "    Typed   = Table.TransformColumnTypes(Chosen, {{\"full_date\", type datetime}, {\"product_name\", type text}, {\"reporting_line\", type text}, {\"fuel_grade\", type text}, {\"actual_litres\", type number}, {\"forecast_litres\", type number}, {\"naive_litres\", type number}, {\"margin_cents_per_litre\", type number}, {\"avg_unit_price_zar\", type number}, {\"abs_error_litres\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "obs_ml_performance",
        "columns": [
          {
            "name": "Model",
            "dataType": "string",
            "sourceColumn": "model",
            "summarizeBy": "none"
          },
          {
            "name": "Model Key",
            "dataType": "string",
            "sourceColumn": "model_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Task",
            "dataType": "string",
            "sourceColumn": "task",
            "summarizeBy": "none"
          },
          {
            "name": "Use Case",
            "dataType": "string",
            "sourceColumn": "use_case",
            "summarizeBy": "none"
          },
          {
            "name": "Target",
            "dataType": "string",
            "sourceColumn": "target",
            "summarizeBy": "none"
          },
          {
            "name": "Grain",
            "dataType": "string",
            "sourceColumn": "grain",
            "summarizeBy": "none"
          },
          {
            "name": "Metric Name",
            "dataType": "string",
            "sourceColumn": "metric_name",
            "summarizeBy": "none"
          },
          {
            "name": "Metric Value",
            "dataType": "double",
            "sourceColumn": "metric_value",
            "summarizeBy": "sum"
          },
          {
            "name": "Baseline Name",
            "dataType": "string",
            "sourceColumn": "baseline_name",
            "summarizeBy": "none"
          },
          {
            "name": "Baseline Value",
            "dataType": "double",
            "sourceColumn": "baseline_value",
            "summarizeBy": "sum"
          },
          {
            "name": "Lift Over Baseline",
            "dataType": "double",
            "sourceColumn": "lift_over_baseline",
            "summarizeBy": "sum"
          },
          {
            "name": "Higher Is Better",
            "dataType": "boolean",
            "sourceColumn": "higher_is_better",
            "summarizeBy": "none"
          },
          {
            "name": "Verdict",
            "dataType": "string",
            "sourceColumn": "verdict",
            "summarizeBy": "none"
          },
          {
            "name": "Train Rows",
            "dataType": "int64",
            "sourceColumn": "train_rows",
            "summarizeBy": "sum"
          },
          {
            "name": "Test Rows",
            "dataType": "int64",
            "sourceColumn": "test_rows",
            "summarizeBy": "sum"
          },
          {
            "name": "N Features",
            "dataType": "int64",
            "sourceColumn": "n_features",
            "summarizeBy": "sum"
          },
          {
            "name": "Interpretation",
            "dataType": "string",
            "sourceColumn": "interpretation",
            "summarizeBy": "none"
          },
          {
            "name": "Disclaimer",
            "dataType": "string",
            "sourceColumn": "disclaimer",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Models",
            "expression": "COUNTROWS ( obs_ml_performance )",
            "formatString": "#,0",
            "displayFolder": "Machine learning"
          },
          {
            "name": "Models Beating Baseline",
            "expression": "CALCULATE ( COUNTROWS ( obs_ml_performance ), obs_ml_performance[Verdict] = \"Beats baseline\" )",
            "formatString": "#,0",
            "displayFolder": "Machine learning"
          },
          {
            "name": "Models Scored",
            "expression": "CALCULATE ( COUNTROWS ( obs_ml_performance ), NOT ISBLANK ( obs_ml_performance[Metric Value] ) )",
            "formatString": "#,0",
            "displayFolder": "Machine learning"
          },
          {
            "name": "Baseline Beat Rate %",
            "expression": "DIVIDE ( [Models Beating Baseline], [Models Scored] )",
            "formatString": "0.0%",
            "displayFolder": "Machine learning"
          },
          {
            "name": "Improvement over Baseline %",
            "expression": "AVERAGEX ( obs_ml_performance, VAR m = obs_ml_performance[Metric Value] VAR b = obs_ml_performance[Baseline Value] RETURN IF ( obs_ml_performance[Higher Is Better], DIVIDE ( m - b, b ), DIVIDE ( b - m, b ) ) )",
            "formatString": "0.0%",
            "displayFolder": "Machine learning"
          },
          {
            "name": "Average Lift over Baseline",
            "expression": "AVERAGE ( obs_ml_performance[Lift Over Baseline] )",
            "formatString": "+0.000;-0.000;0.000",
            "displayFolder": "Machine learning"
          },
          {
            "name": "Best ROC-AUC",
            "expression": "CALCULATE ( MAX ( obs_ml_performance[Metric Value] ), obs_ml_performance[Metric Name] = \"roc_auc\" )",
            "formatString": "0.000",
            "displayFolder": "Machine learning"
          },
          {
            "name": "Training Rows",
            "expression": "SUM ( obs_ml_performance[Train Rows] )",
            "formatString": "#,0",
            "displayFolder": "Machine learning"
          }
        ],
        "partitions": [
          {
            "name": "obs_ml_performance",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Path    = DataFolder & \"obs_ml_performance.csv\",",
                "    Source  = Csv.Document(File.Contents(Path), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Chosen  = Table.SelectColumns(Headers, {\"model\", \"model_key\", \"task\", \"use_case\", \"target\", \"grain\", \"metric_name\", \"metric_value\", \"baseline_name\", \"baseline_value\", \"lift_over_baseline\", \"higher_is_better\", \"verdict\", \"train_rows\", \"test_rows\", \"n_features\", \"interpretation\", \"disclaimer\"}),",
                "    Typed   = Table.TransformColumnTypes(Chosen, {{\"model\", type text}, {\"model_key\", type text}, {\"task\", type text}, {\"use_case\", type text}, {\"target\", type text}, {\"grain\", type text}, {\"metric_name\", type text}, {\"metric_value\", type number}, {\"baseline_name\", type text}, {\"baseline_value\", type number}, {\"lift_over_baseline\", type number}, {\"higher_is_better\", type logical}, {\"verdict\", type text}, {\"train_rows\", Int64.Type}, {\"test_rows\", Int64.Type}, {\"n_features\", Int64.Type}, {\"interpretation\", type text}, {\"disclaimer\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "obs_cleansing_summary",
        "columns": [
          {
            "name": "Table Name",
            "dataType": "string",
            "sourceColumn": "table_name",
            "summarizeBy": "none"
          },
          {
            "name": "Raw Rows",
            "dataType": "int64",
            "sourceColumn": "raw_rows",
            "summarizeBy": "sum"
          },
          {
            "name": "Cleansed Rows",
            "dataType": "int64",
            "sourceColumn": "cleansed_rows",
            "summarizeBy": "sum"
          },
          {
            "name": "Quarantined Rows",
            "dataType": "int64",
            "sourceColumn": "quarantined_rows",
            "summarizeBy": "sum"
          },
          {
            "name": "Duplicates Removed",
            "dataType": "int64",
            "sourceColumn": "duplicates_removed",
            "summarizeBy": "sum"
          },
          {
            "name": "Quarantine Rate % (row)",
            "dataType": "double",
            "sourceColumn": "quarantine_rate_pct",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0.0%"
          },
          {
            "name": "Duplicate Rate % (row)",
            "dataType": "double",
            "sourceColumn": "duplicate_rate_pct",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "0.0%"
          },
          {
            "name": "Pass Rate %",
            "dataType": "double",
            "sourceColumn": "pass_rate_pct",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "Quarantine Status",
            "dataType": "string",
            "sourceColumn": "quarantine_status",
            "summarizeBy": "none"
          },
          {
            "name": "Row Count Reconciles",
            "dataType": "boolean",
            "sourceColumn": "row_count_reconciles",
            "summarizeBy": "none"
          },
          {
            "name": "Evaluated At",
            "dataType": "dateTime",
            "sourceColumn": "evaluated_at",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          }
        ],
        "measures": [
          {
            "name": "Rows Landed",
            "expression": "SUM ( obs_cleansing_summary[Raw Rows] )",
            "formatString": "#,0",
            "displayFolder": "Data quality"
          },
          {
            "name": "Rows Cleansed",
            "expression": "SUM ( obs_cleansing_summary[Cleansed Rows] )",
            "formatString": "#,0",
            "displayFolder": "Data quality"
          },
          {
            "name": "Rows Quarantined",
            "expression": "SUM ( obs_cleansing_summary[Quarantined Rows] )",
            "formatString": "#,0",
            "displayFolder": "Data quality"
          },
          {
            "name": "Quarantine Rate %",
            "expression": "DIVIDE ( [Rows Quarantined], [Rows Landed] )",
            "formatString": "0.00%",
            "displayFolder": "Data quality"
          },
          {
            "name": "Duplicate Rate %",
            "expression": "DIVIDE ( SUM ( obs_cleansing_summary[Duplicates Removed] ), [Rows Landed] )",
            "formatString": "0.00%",
            "displayFolder": "Data quality"
          },
          {
            "name": "Tables Monitored",
            "expression": "DISTINCTCOUNT ( obs_cleansing_summary[Table Name] )",
            "formatString": "#,0",
            "displayFolder": "Data quality"
          },
          {
            "name": "Tables Not Reconciling",
            "expression": "CALCULATE ( [Tables Monitored], obs_cleansing_summary[Row Count Reconciles] = FALSE () )",
            "formatString": "#,0",
            "displayFolder": "Data quality"
          }
        ],
        "partitions": [
          {
            "name": "obs_cleansing_summary",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Path    = DataFolder & \"obs_cleansing_summary.csv\",",
                "    Source  = Csv.Document(File.Contents(Path), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Chosen  = Table.SelectColumns(Headers, {\"table_name\", \"raw_rows\", \"cleansed_rows\", \"quarantined_rows\", \"duplicates_removed\", \"quarantine_rate_pct\", \"duplicate_rate_pct\", \"pass_rate_pct\", \"quarantine_status\", \"row_count_reconciles\", \"evaluated_at\"}),",
                "    Typed   = Table.TransformColumnTypes(Chosen, {{\"table_name\", type text}, {\"raw_rows\", Int64.Type}, {\"cleansed_rows\", Int64.Type}, {\"quarantined_rows\", Int64.Type}, {\"duplicates_removed\", Int64.Type}, {\"quarantine_rate_pct\", type number}, {\"duplicate_rate_pct\", type number}, {\"pass_rate_pct\", type number}, {\"quarantine_status\", type text}, {\"row_count_reconciles\", type logical}, {\"evaluated_at\", type datetime}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "obs_quarantine_reasons",
        "columns": [
          {
            "name": "Table Name",
            "dataType": "string",
            "sourceColumn": "table_name",
            "summarizeBy": "none"
          },
          {

          },
          {
            "name": "Cogs (R)",
            "dataType": "decimal",
            "sourceColumn": "cogs_zar",
            "summarizeBy": "sum",
            "formatString": "\"R\"#,0.00"
          },
          {
            "name": "Gross Margin (R)",
            "dataType": "decimal",
            "sourceColumn": "gross_margin_zar",
            "summarizeBy": "sum",
            "formatString": "\"R\"#,0.00"
          },
          {
            "name": "Unit Price (R)",
            "dataType": "double",
            "sourceColumn": "unit_price_zar",
            "summarizeBy": "sum",
            "formatString": "\"R\"#,0.00"
          },
          {
            "name": "Line Margin %",
            "dataType": "double",
            "sourceColumn": "line_margin_pct",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "Margin Cents Per Litre",
            "dataType": "double",
            "sourceColumn": "margin_cents_per_litre",
            "summarizeBy": "sum"
          },
          {
            "name": "Source System Code",
            "dataType": "string",
            "sourceColumn": "source_system_code",
            "summarizeBy": "none"
          },
          {
            "name": "Ingested At",
            "dataType": "dateTime",
            "sourceColumn": "ingested_at",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "Cleansed At",
            "dataType": "dateTime",
            "sourceColumn": "_cleansed_at",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "yyyy-mm-dd"
          }
        ],
        "measures": [
          {
            "name": "Retail Litres",
            "expression": "SUM ( fct_retail_fuel_sales[Litres] )",
            "formatString": "#,0",
            "displayFolder": "Products"
          },
          {
            "name": "Retail Revenue",
            "expression": "SUM ( fct_retail_fuel_sales[Gross Sales (R)] )",
            "formatString": "\"R\"#,0",
            "displayFolder": "Products"
          },
          {
            "name": "Retail Margin",
            "expression": "SUM ( fct_retail_fuel_sales[Gross Margin (R)] )",
            "formatString": "\"R\"#,0",
            "displayFolder": "Products"
          },
          {
            "name": "Retail Margin %",
            "expression": "DIVIDE ( [Retail Margin], [Retail Revenue] )",
            "formatString": "0.0%",
            "displayFolder": "Products"
          },
          {
            "name": "Margin (c/L)",
            "expression": "DIVIDE ( [Retail Margin], [Retail Litres] ) * 100",
            "formatString": "#,0.0",
            "displayFolder": "Products"
          },
          {
            "name": "Average Pump Price",
            "expression": "AVERAGE ( fct_retail_fuel_sales[Unit Price (R)] )",
            "formatString": "\"R\"#,0.00",
            "displayFolder": "Products"
          },
          {
            "name": "Litres Share %",
            "expression": "DIVIDE ( [Retail Litres], CALCULATE ( [Retail Litres], REMOVEFILTERS ( dim_product ) ) )",
            "formatString": "0.0%",
            "displayFolder": "Products"
          },
          {
            "name": "Regulated Litres %",
            "expression": "DIVIDE ( CALCULATE ( [Retail Litres], fct_retail_fuel_sales[Is Regulated Price] = TRUE ), [Retail Litres] )",
            "formatString": "0.0%",
            "displayFolder": "Products"
          },
          {
            "name": "Fuel Grades Sold",
            "expression": "DISTINCTCOUNT ( fct_retail_fuel_sales[Fuel Grade] )",
            "formatString": "#,0",
            "displayFolder": "Products"
          },
          {
            "name": "Retail Litres LY",
            "expression": "CALCULATE ( [Retail Litres], SAMEPERIODLASTYEAR ( dim_date[Full Date] ) )",
            "formatString": "#,0",
            "displayFolder": "Products"
          },
          {
            "name": "Retail Litres YoY %",
            "expression": "DIVIDE ( [Retail Litres] - [Retail Litres LY], [Retail Litres LY] )",
            "formatString": "0.0%",
            "displayFolder": "Products"
          }
        ],
        "partitions": [
          {
            "name": "fct_retail_fuel_sales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Path    = DataFolder & \"fct_retail_fuel_sales.csv\",",
                "    Source  = Csv.Document(File.Contents(Path), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Chosen  = Table.SelectColumns(Headers, {\"transaction_id\", \"transaction_ts\", \"date_key\", \"time_key\", \"site_key\", \"product_key\", \"site_id\", \"product_id\", \"province\", \"city\", \"country_code\", \"urban_class\", \"site_type\", \"ownership_model\", \"demand_band\", \"product_name\", \"fuel_grade\", \"reporting_line\", \"is_regulated_price\", \"is_unmatched_site\", \"is_unmatched_product\", \"pump_number\", \"forecourt_lane\", \"shift_name\", \"payment_method\", \"loyalty_flag\", \"loyalty_member_id\", \"is_fleet_sale\", \"litres\", \"gross_sales_zar\", \"cogs_zar\", \"gross_margin_zar\", \"unit_price_zar\", \"line_margin_pct\", \"margin_cents_per_litre\", \"source_system_code\", \"ingested_at\", \"_cleansed_at\"}),",
                "    Typed   = Table.TransformColumnTypes(Chosen, {{\"transaction_id\", type text}, {\"transaction_ts\", type datetime}, {\"date_key\", Int64.Type}, {\"time_key\", Int64.Type}, {\"site_key\", Int64.Type}, {\"product_key\", Int64.Type}, {\"site_id\", type text}, {\"product_id\", type text}, {\"province\", type text}, {\"city\", type text}, {\"country_code\", type text}, {\"urban_class\", type text}, {\"site_type\", type text}, {\"ownership_model\", type text}, {\"demand_band\", type text}, {\"product_name\", type text}, {\"fuel_grade\", type text}, {\"reporting_line\", type text}, {\"is_regulated_price\", type logical}, {\"is_unmatched_site\", type logical}, {\"is_unmatched_product\", type logical}, {\"pump_number\", Int64.Type}, {\"forecourt_lane\", Int64.Type}, {\"shift_name\", type text}, {\"payment_method\", type text}, {\"loyalty_flag\", type logical}, {\"loyalty_member_id\", type text}, {\"is_fleet_sale\", type logical}, {\"litres\", type number}, {\"gross_sales_zar\", type number}, {\"cogs_zar\", type number}, {\"gross_margin_zar\", type number}, {\"unit_price_zar\", type number}, {\"line_margin_pct\", type number}, {\"margin_cents_per_litre\", type number}, {\"source_system_code\", type text}, {\"ingested_at\", type datetime}, {\"_cleansed_at\", type datetime}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "agg_site_daily_fuel",
        "columns": [
          {
            "name": "Date Key",
            "dataType": "int64",
            "sourceColumn": "date_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Site Key",
            "dataType": "int64",
            "sourceColumn": "site_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Site ID",
            "dataType": "string",
            "sourceColumn": "site_id",
            "summarizeBy": "none"
          },
          {
            "name": "Province",
            "dataType": "string",
            "sourceColumn": "province",
            "summarizeBy": "none",
            "dataCategory": "StateOrProvince"
          },
          {
            "name": "Urban Class",
            "dataType": "string",
            "sourceColumn": "urban_class",
            "summarizeBy": "none"
          },
          {
            "name": "Site Type",
            "dataType": "string",
            "sourceColumn": "site_type",
            "summarizeBy": "none"
          },
          {
            "name": "Demand Band",
            "dataType": "string",
            "sourceColumn": "demand_band",
            "summarizeBy": "none"
          },
          {
            "name": "Transaction Count (row)",
            "dataType": "int64",
            "sourceColumn": "transaction_count",
            "summarizeBy": "sum",
            "isHidden": true
          },
          {
            "name": "Grades Sold",
            "dataType": "int64",
            "sourceColumn": "grades_sold",
            "summarizeBy": "sum"
          },
          {
            "name": "Litres",
            "dataType": "double",
            "sourceColumn": "litres",
            "summarizeBy": "sum"
          },
          {
            "name": "Gross Sales (R)",
            "dataType": "decimal",
            "sourceColumn": "gross_sales_zar",
            "summarizeBy": "sum",
            "formatString": "\"R\"#,0.00"
          },
          {
            "name": "Cogs (R)",
            "dataType": "decimal",
            "sourceColumn": "cogs_zar",
            "summarizeBy": "sum",
            "formatString": "\"R\"#,0.00"
          },
          {
            "name": "Gross Margin (R)",
            "dataType": "decimal",
            "sourceColumn": "gross_margin_zar",
            "summarizeBy": "sum",
            "formatString": "\"R\"#,0.00"
          },
          {
            "name": "Diesel Litres",
            "dataType": "double",
            "sourceColumn": "diesel_litres",
            "summarizeBy": "sum"
          },
          {

            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Sites Scored",
            "expression": "COUNTROWS ( network_investment_scorecard )",
            "formatString": "#,0",
            "displayFolder": "Network"
          },
          {
            "name": "Average Investment Score",
            "expression": "AVERAGE ( network_investment_scorecard[Investment Score] )",
            "formatString": "#,0.0",
            "displayFolder": "Network"
          },
          {
            "name": "Divest Candidates",
            "expression": "CALCULATE ( [Sites Scored], CONTAINSSTRING ( network_investment_scorecard[Investment Recommendation], \"Divest\" ) )",
            "formatString": "#,0",
            "displayFolder": "Network"
          },
          {
            "name": "Margin at Risk",
            "expression": "CALCULATE ( SUM ( network_investment_scorecard[Total Margin (R)] ), CONTAINSSTRING ( network_investment_scorecard[Investment Recommendation], \"Divest\" ) )",
            "formatString": "\"R\"#,0",
            "displayFolder": "Network"
          },
          {
            "name": "Downtime Hours",
            "expression": "SUM ( network_investment_scorecard[Downtime Hours (row)] )",
            "formatString": "#,0",
            "displayFolder": "Assets"
          },
          {
            "name": "Corridor Sites",
            "expression": "CALCULATE ( DISTINCTCOUNT ( dim_site[Site Key] ), dim_site[On National Route] = TRUE () )",
            "formatString": "#,0",
            "displayFolder": "Network"
          }
        ],
        "partitions": [
          {
            "name": "network_investment_scorecard",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Path    = DataFolder & \"network_investment_scorecard.csv\",",
                "    Source  = Csv.Document(File.Contents(Path), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",

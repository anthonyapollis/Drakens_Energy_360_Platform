
digraph ERD {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.8", splines=ortho];
  node [shape=record, fontname="Arial", fontsize=10, margin="0.08,0.04"];
  edge [fontname="Arial", fontsize=8, arrowsize=0.65];

  subgraph cluster_dims {
    label="CONFORMED DIMENSIONS";
    style="rounded";
    dim_country [label="{DIM_COUNTRY|PK country_code|country_name|market_group|currency_code}"];
    dim_site [label="{DIM_SITE|PK site_id|FK country_code|province|city|brand|lat / lon|ownership_model}"];
    dim_terminal [label="{DIM_TERMINAL|PK terminal_id|FK country_code|capacity_litres|connectivity flags}"];
    dim_product [label="{DIM_PRODUCT|PK product_id|product_name|product_group|subgroup|uom}"];
    dim_customer [label="{DIM_CUSTOMER|PK customer_id|FK country_code|sector|credit_band|contract_type}"];
    dim_supplier [label="{DIM_SUPPLIER|PK supplier_id|FK country_code|supplier_type|risk_rating}"];
    dim_vehicle [label="{DIM_VEHICLE|PK vehicle_id|vehicle_type|capacity|carrier}"];
    dim_asset [label="{DIM_ASSET|PK asset_id|FK site_id|asset_type|install_date}"];
  }

  subgraph cluster_retail {
    label="RETAIL & DIGITAL FACTS";
    style="rounded";
    f_retail [label="{FACT_RETAIL_FUEL_SALES|PK transaction_id|FK site_id|FK product_id|litres|sales|COGS|margin}"];
    f_shop [label="{FACT_SHOP_SALES|PK shop_line_id|FK site_id|FK product_id|quantity|sales|margin}"];
    f_loyalty [label="{FACT_LOYALTY_TRANSACTIONS|PK loyalty_txn_id|FK site_id|member_token|spend|points}"];
    f_digital [label="{FACT_DIGITAL_EVENTS|PK event_id|FK site_id|user_token|event_name|success_flag}"];
  }

  subgraph cluster_commercial {
    label="COMMERCIAL & SPECIALTY FACTS";
    style="rounded";
    f_comm [label="{FACT_COMMERCIAL_ORDERS|PK order_id|FK customer_id|FK product_id|volume|revenue|status}"];
    f_aviation [label="{FACT_AVIATION_SALES|PK aviation_sale_id|FK customer_id|FK site_id|uplift_litres|revenue}"];
    f_marine [label="{FACT_MARINE_SALES|PK marine_sale_id|FK customer_id|FK site_id|bunker_litres|revenue}"];
    f_lpg [label="{FACT_LPG_SALES|PK lpg_sale_id|FK site_id|FK customer_id|FK product_id|quantity_kg|revenue}"];
    f_lube [label="{FACT_LUBRICANT_SALES|PK lubricant_sale_id|FK site_id|FK customer_id|FK product_id|litres|revenue}"];
  }

  subgraph cluster_supply {
    label="SUPPLY, STORAGE & LOGISTICS FACTS";
    style="rounded";
    f_inv [label="{FACT_INVENTORY_SNAPSHOT|PK snapshot_id|FK site_id|FK terminal_id|FK product_id|stock|ullage|days_cover}"];
    f_delivery [label="{FACT_DELIVERIES|PK delivery_id|FK terminal_id|FK site_id|FK customer_id|FK vehicle_id|FK product_id|litres|OTIF}"];
    f_proc [label="{FACT_PROCUREMENT_RECEIPTS|PK receipt_id|FK supplier_id|FK terminal_id|FK product_id|quantity|cost}"];
  }

  subgraph cluster_ops {
    label="NEW ENERGY, ASSET & HSSEQ FACTS";
    style="rounded";
    f_ev [label="{FACT_EV_CHARGING_SESSIONS|PK charging_session_id|FK site_id|kWh|duration|revenue}"];
    f_solar [label="{FACT_SOLAR_GENERATION|PK solar_reading_id|FK site_id|generation_kWh|consumption|grid_import}"];
    f_maint [label="{FACT_MAINTENANCE_WORK_ORDERS|PK work_order_id|FK asset_id|type|failure_mode|downtime|cost}"];
    f_hsseq [label="{FACT_HSSEQ_INCIDENTS|PK incident_id|FK site_id|type|severity|lost_time|spill_volume}"];
  }

  dim_country -> dim_site;
  dim_country -> dim_terminal;
  dim_country -> dim_customer;
  dim_site -> dim_asset;

  dim_site -> f_retail; dim_product -> f_retail;
  dim_site -> f_shop; dim_product -> f_shop;
  dim_site -> f_loyalty;
  dim_site -> f_digital;

  dim_customer -> f_comm; dim_product -> f_comm;
  dim_customer -> f_aviation; dim_site -> f_aviation;
  dim_customer -> f_marine; dim_site -> f_marine;
  dim_site -> f_lpg; dim_customer -> f_lpg; dim_product -> f_lpg;
  dim_site -> f_lube; dim_customer -> f_lube; dim_product -> f_lube;

  dim_site -> f_inv; dim_terminal -> f_inv; dim_product -> f_inv;
  dim_terminal -> f_delivery; dim_site -> f_delivery; dim_customer -> f_delivery; dim_vehicle -> f_delivery; dim_product -> f_delivery;
  dim_supplier -> f_proc; dim_terminal -> f_proc; dim_product -> f_proc;

  dim_site -> f_ev;
  dim_site -> f_solar;
  dim_asset -> f_maint;
  dim_site -> f_hsseq;
}

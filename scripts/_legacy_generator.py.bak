def ids(prefix: str, n: int, width: int = 7):
    return np.array([f"{prefix}{i:0{width}d}" for i in range(1, n + 1)])

def dt_random(rng, n, start, end):
    s = np.datetime64(start, "s")
    e = np.datetime64(end, "s")
    sec = int((e - s) / np.timedelta64(1, "s"))
    return pd.to_datetime(s + rng.integers(0, sec + 1, n).astype("timedelta64[s]"))

def write_table(df, out: Path, name: str, fmt: str):
    if fmt == "csv":
        df.to_csv(out / f"{name}.csv", index=False)
    else:
        df.to_parquet(out / f"{name}.parquet", index=False, compression="snappy")

def chunked_count(n: int, chunk_size: int):
    for start in range(0, n, chunk_size):
        yield start, min(chunk_size, n - start)

def write_fact_chunks(make_chunk, total, out, name, fmt, chunk_size=250_000):
    if fmt == "csv":
        path = out / f"{name}.csv"
        first = True
        for start, n in chunked_count(total, chunk_size):
            df = make_chunk(start, n)
            df.to_csv(path, index=False, mode="w" if first else "a", header=first)
            first = False
    else:
        # Multiple part files to avoid holding multi-million rows in RAM.
        folder = out / name
        folder.mkdir(exist_ok=True)
        for start, n in chunked_count(total, chunk_size):
            df = make_chunk(start, n)
            df.to_parquet(folder / f"part-{start:012d}.parquet", index=False, compression="snappy")

def build_dimensions(rng, scale, out, fmt):
    # Sites: portfolio/enterprise approximate public order of magnitude.
    site_count = {"demo": 220, "portfolio": 4200, "enterprise": 8000}[scale]
    sa_count = {"demo": 80, "portfolio": 1050, "enterprise": 1800}[scale]

    market_codes = [x[0] for x in MARKETS if x[0] != "ZA"]
    other_count = site_count - sa_count

    site_rows = []
    weights = np.array([x[4] for x in SA_PROVINCE_CITY], dtype=float)
    weights /= weights.sum()

    for i in range(sa_count):
        idx = int(rng.choice(len(SA_PROVINCE_CITY), p=weights))
        province, city, lat, lon, _ = SA_PROVINCE_CITY[idx]
        site_rows.append((
            f"S{i+1:06d}", f"Synthetic Engen {city} {i+1:04d}", "ZA", province, city,
            "Engen", "Service Station",
            float(lat + rng.normal(0, 0.025)), float(lon + rng.normal(0, 0.025)),
            rng.choice(["COCO","CODO","DODO"], p=[.12,.58,.30]),
            bool(rng.random() < .68), bool(rng.random() < .15), bool(rng.random() < .12)
        ))

    market_weights = rng.dirichlet(np.ones(len(market_codes)) * 2.0)
    assigned = rng.choice(market_codes, other_count, p=market_weights)
    for j, cc in enumerate(assigned, start=sa_count+1):
        lat, lon = OTHER_MARKET_CENTRES[cc]
        brand = rng.choice(["Shell","Engen"], p=[.72,.28])  # synthetic, not authoritative market-brand mapping
        site_rows.append((
            f"S{j:06d}", f"Synthetic {brand} Site {j:05d}", cc, None, None,
            brand, "Service Station",
            float(lat + rng.normal(0, 0.45)), float(lon + rng.normal(0, 0.45)),
            rng.choice(["COCO","CODO","DODO"], p=[.12,.58,.30]),
            bool(rng.random() < .48), bool(rng.random() < .08), bool(rng.random() < .06)
        ))

    site = pd.DataFrame(site_rows, columns=[
        "site_id","site_name","country_code","province","city","brand","site_type",
        "latitude","longitude","ownership_model","convenience_flag","ev_flag","solar_flag"
    ])
    write_table(site, out, "dim_site", fmt)

    country = pd.DataFrame(MARKETS, columns=["country_code","country_name"])
    country["market_group"] = np.where(country["country_code"].isin(["ZA","NA","BW","LS","SZ","ZW","ZM","MZ","MW"]),
                                       "Southern Africa", "Africa & Other")
    country["currency_code"] = np.where(country["country_code"]=="ZA","ZAR","LCY")
    write_table(country, out, "dim_country", fmt)

    product = pd.DataFrame(PRODUCTS, columns=["product_id","product_name","product_group","product_subgroup","uom"])
    product["brand"] = rng.choice(["Engen","Shell","Unbranded"], len(product), p=[.45,.45,.10])
    write_table(product, out, "dim_product", fmt)

    n_customers = {"demo": 1500, "portfolio": 150_000, "enterprise": 600_000}[scale]
    customer = pd.DataFrame({
        "customer_id": ids("C", n_customers),
        "customer_name": [f"Synthetic Customer {i:07d}" for i in range(1,n_customers+1)],
        "sector": rng.choice(["Road Transport","Mining","Construction","Power","Aviation","Marine",
                              "Reseller","Industrial","Government","SME"], n_customers),
        "country_code": rng.choice([x[0] for x in MARKETS], n_customers),
        "credit_band": rng.choice(["A","B","C","D"], n_customers, p=[.28,.42,.23,.07]),
        "contract_type": rng.choice(["Long-term","Tender","Spot"], n_customers, p=[.5,.25,.25]),
    })
    write_table(customer, out, "dim_customer", fmt)

    n_suppliers = {"demo": 120, "portfolio": 3000, "enterprise": 8000}[scale]
    supplier = pd.DataFrame({
        "supplier_id": ids("SUP", n_suppliers, 5),
        "supplier_name": [f"Synthetic Supplier {i:05d}" for i in range(1,n_suppliers+1)],
        "supplier_type": rng.choice(["Refinery","Importer","Transporter","Packaging","Food & Beverage","Maintenance"], n_suppliers),
        "country_code": rng.choice([x[0] for x in MARKETS], n_suppliers),
        "risk_rating": rng.choice(["Low","Medium","High"], n_suppliers, p=[.65,.28,.07])
    })
    write_table(supplier, out, "dim_supplier", fmt)

    n_terminals = {"demo": 40, "portfolio": 180, "enterprise": 300}[scale]
    terminal = pd.DataFrame({
        "terminal_id": ids("T", n_terminals, 4),
        "terminal_name": [f"Synthetic Terminal {i:04d}" for i in range(1,n_terminals+1)],
        "country_code": rng.choice([x[0] for x in MARKETS], n_terminals),
        "capacity_litres": rng.integers(3_000_000, 130_000_000, n_terminals),
        "pipeline_connected_flag": rng.random(n_terminals) < .30,
        "rail_connected_flag": rng.random(n_terminals) < .35,
        "port_connected_flag": rng.random(n_terminals) < .40,
    })
    write_table(terminal, out, "dim_terminal", fmt)

    n_vehicles = {"demo": 250, "portfolio": 15_000, "enterprise": 40_000}[scale]
    vehicle = pd.DataFrame({
        "vehicle_id": ids("V", n_vehicles, 6),
        "vehicle_type": rng.choice(["Fuel Tanker","LPG Tanker","Lubricant Truck"], n_vehicles, p=[.78,.14,.08]),
        "capacity_litres": rng.choice([18000,24000,32000,36000,42000], n_vehicles),
        "carrier": [f"Synthetic Carrier {x:04d}" for x in rng.integers(1,500,n_vehicles)],
        "active_flag": True
    })
    write_table(vehicle, out, "dim_vehicle", fmt)

    n_assets = {"demo": 1000, "portfolio": 50_000, "enterprise": 120_000}[scale]
    asset = pd.DataFrame({
        "asset_id": ids("A", n_assets, 7),
        "site_id": rng.choice(site["site_id"], n_assets),
        "asset_type": rng.choice(["Pump","Tank","Generator","POS","EV Charger","Solar Inverter","Compressor","Fire System"], n_assets),
        "manufacturer": rng.choice(["Synthetic OEM A","Synthetic OEM B","Synthetic OEM C"], n_assets),
        "install_date": pd.to_datetime(rng.choice(pd.date_range("2005-01-01","2026-06-30"), n_assets)).date
    })
    write_table(asset, out, "dim_asset", fmt)

    return {
        "site": site, "product": product, "customer": customer, "supplier": supplier,
        "terminal": terminal, "vehicle": vehicle, "asset": asset
    }

def generate(scale, output, fmt, seed):
    rng = np.random.default_rng(seed)
    cfg = SCALES[scale]
    out = Path(output)
    out.mkdir(parents=True, exist_ok=True)
    dims = build_dimensions(rng, scale, out, fmt)

    site_ids = dims["site"]["site_id"].to_numpy()
    za_site_ids = dims["site"].loc[dims["site"]["country_code"]=="ZA","site_id"].to_numpy()
    product = dims["product"]
    fuel_ids = product.loc[product["product_group"]=="Fuel","product_id"].to_numpy()
    shop_ids = product.loc[product["product_group"]=="Convenience","product_id"].to_numpy()
    lpg_ids = product.loc[product["product_group"]=="LPG","product_id"].to_numpy()
    lube_ids = product.loc[product["product_group"]=="Lubricant","product_id"].to_numpy()
    customer_ids = dims["customer"]["customer_id"].to_numpy()
    supplier_ids = dims["supplier"]["supplier_id"].to_numpy()
    terminal_ids = dims["terminal"]["terminal_id"].to_numpy()
    vehicle_ids = dims["vehicle"]["vehicle_id"].to_numpy()
    asset_ids = dims["asset"]["asset_id"].to_numpy()

    date_start = "2024-01-01"
    date_end = "2026-09-06"

    def retail_chunk(start, n):
        dt = dt_random(rng,n,date_start,date_end)
        litres = rng.gamma(2.2, 18.0, n).clip(2, 180)
        unit_price = rng.uniform(18, 31, n)
        return pd.DataFrame({
            "transaction_id":[f"RF{start+i+1:012d}" for i in range(n)],
            "transaction_ts":dt,
            "site_id":rng.choice(site_ids,n),
            "product_id":rng.choice(fuel_ids,n),
            "pump_no":rng.integers(1,13,n),
            "litres":litres.round(3),
            "unit_price_lcy":unit_price.round(3),
            "gross_sales_lcy":(litres*unit_price).round(2),
            "estimated_cogs_lcy":(litres*unit_price*rng.uniform(.76,.91,n)).round(2),
            "payment_method":rng.choice(["Card","Cash","Fleet Card","Mobile App"],n,p=[.48,.27,.16,.09]),
            "loyalty_flag":rng.random(n)<.34
        })

    def shop_chunk(start,n):
        qty=rng.integers(1,5,n); price=rng.uniform(8,180,n)
        return pd.DataFrame({
            "shop_line_id":[f"SH{start+i+1:012d}" for i in range(n)],
            "transaction_ts":dt_random(rng,n,date_start,date_end),
            "site_id":rng.choice(site_ids,n),
            "product_id":rng.choice(shop_ids,n),
            "quantity":qty,
            "unit_price_lcy":price.round(2),
            "gross_sales_lcy":(qty*price).round(2),
            "estimated_cogs_lcy":(qty*price*rng.uniform(.45,.76,n)).round(2)
        })

    def commercial_chunk(start,n):
        litres=rng.lognormal(8.4,1.0,n).clip(500,900000); price=rng.uniform(15,30,n)
        return pd.DataFrame({
            "order_id":[f"CO{start+i+1:011d}" for i in range(n)],
            "order_ts":dt_random(rng,n,date_start,date_end),
            "customer_id":rng.choice(customer_ids,n),
            "product_id":rng.choice(fuel_ids,n),
            "volume_litres":litres.round(2),
            "unit_price_lcy":price.round(3),
            "revenue_lcy":(litres*price).round(2),
            "contract_channel":rng.choice(["Contract","Tender","Spot"],n,p=[.55,.25,.20]),
            "order_status":rng.choice(["Delivered","Partial","Cancelled"],n,p=[.95,.04,.01])
        })

    def inventory_chunk(start,n):
        cap=rng.uniform(40_000,4_000_000,n); stock=cap*rng.beta(3,2,n)
        return pd.DataFrame({
            "snapshot_id":[f"INV{start+i+1:011d}" for i in range(n)],
            "snapshot_ts":dt_random(rng,n,date_start,date_end),
            "location_type":rng.choice(["Site","Terminal"],n,p=[.75,.25]),
            "site_id":rng.choice(site_ids,n),
            "terminal_id":rng.choice(terminal_ids,n),
            "product_id":rng.choice(fuel_ids,n),
            "capacity_litres":cap.round(2),
            "stock_on_hand_litres":stock.round(2),
            "ullage_litres":(cap-stock).round(2),
            "estimated_days_cover":rng.uniform(.2,15,n).round(2)
        })

    def delivery_chunk(start,n):
        planned=dt_random(rng,n,date_start,date_end); mins=rng.normal(35,80,n)
        actual=planned+pd.to_timedelta(mins,unit="m")
        return pd.DataFrame({
            "delivery_id":[f"DL{start+i+1:011d}" for i in range(n)],
            "planned_arrival_ts":planned,
            "actual_arrival_ts":actual,
            "terminal_id":rng.choice(terminal_ids,n),
            "destination_site_id":rng.choice(site_ids,n),
            "customer_id":rng.choice(customer_ids,n),
            "vehicle_id":rng.choice(vehicle_ids,n),
            "product_id":rng.choice(fuel_ids,n),
            "delivered_litres":rng.uniform(3000,42000,n).round(2),
            "distance_km":rng.gamma(2.2,120,n).clip(2,1400).round(1),
            "otif_flag":np.abs(mins)<=60
        })

    def procurement_chunk(start,n):
        qty=rng.uniform(20_000,4_500_000,n); uc=rng.uniform(8,22,n)
        return pd.DataFrame({
            "receipt_id":[f"PR{start+i+1:011d}" for i in range(n)],
            "receipt_ts":dt_random(rng,n,date_start,date_end),
            "supplier_id":rng.choice(supplier_ids,n),
            "terminal_id":rng.choice(terminal_ids,n),
            "product_id":rng.choice(fuel_ids,n),
            "quantity_litres":qty.round(2),
            "unit_cost_lcy":uc.round(3),
            "total_cost_lcy":(qty*uc).round(2),
            "source_mode":rng.choice(["Import Vessel","Refinery","Pipeline","Road","Rail"],n)
        })

    def aviation_chunk(start,n):
        litres=rng.uniform(1000,220000,n); price=rng.uniform(13,28,n)
        return pd.DataFrame({
            "aviation_sale_id":[f"AV{start+i+1:011d}" for i in range(n)],
            "sale_ts":dt_random(rng,n,date_start,date_end),
            "customer_id":rng.choice(customer_ids,n),
            "site_id":rng.choice(site_ids,n),
            "product_id":"F005",
            "uplift_litres":litres.round(2),
            "revenue_lcy":(litres*price).round(2),
            "flight_type":rng.choice(["Commercial","Cargo","Charter","Government"],n)
        })

    def marine_chunk(start,n):
        litres=rng.uniform(5000,1_800_000,n); price=rng.uniform(10,24,n)
        return pd.DataFrame({
            "marine_sale_id":[f"MR{start+i+1:011d}" for i in range(n)],
            "sale_ts":dt_random(rng,n,date_start,date_end),
            "customer_id":rng.choice(customer_ids,n),
            "site_id":rng.choice(site_ids,n),
            "product_id":rng.choice(["F006","F007"],n),
            "bunker_litres":litres.round(2),
            "revenue_lcy":(litres*price).round(2),
            "vessel_class":rng.choice(["Container","Bulk Carrier","Tanker","Fishing","Naval","Offshore"],n)
        })

    def lpg_chunk(start,n):
        kg=rng.gamma(2.0,110,n).clip(9,30000); price=rng.uniform(18,45,n)
        return pd.DataFrame({
            "lpg_sale_id":[f"LP{start+i+1:011d}" for i in range(n)],
            "sale_ts":dt_random(rng,n,date_start,date_end),
            "site_id":rng.choice(site_ids,n),
            "customer_id":rng.choice(customer_ids,n),
            "product_id":rng.choice(lpg_ids,n),
            "quantity_kg":kg.round(3),
            "revenue_lcy":(kg*price).round(2),
            "channel":rng.choice(["Retail Cylinder","Commercial Bulk","Distributor"],n)
        })

    def lube_chunk(start,n):
        litres=rng.gamma(2.0,35,n).clip(1,15000); price=rng.uniform(35,240,n)
        return pd.DataFrame({
            "lubricant_sale_id":[f"LU{start+i+1:011d}" for i in range(n)],
            "sale_ts":dt_random(rng,n,date_start,date_end),
            "site_id":rng.choice(site_ids,n),
            "customer_id":rng.choice(customer_ids,n),
            "product_id":rng.choice(lube_ids,n),
            "quantity_litres":litres.round(2),
            "revenue_lcy":(litres*price).round(2),
            "channel":rng.choice(["Retail","Workshop","Commercial","Distributor"],n)
        })

    def loyalty_chunk(start,n):
        spend=rng.gamma(2.2,180,n)
        return pd.DataFrame({
            "loyalty_txn_id":[f"LY{start+i+1:012d}" for i in range(n)],
            "transaction_ts":dt_random(rng,n,date_start,date_end),
            "member_token":[hashlib.sha256(f"M{start+i}".encode()).hexdigest()[:20] for i in range(n)],
            "site_id":rng.choice(site_ids,n),
            "spend_lcy":spend.round(2),
            "points_earned":np.floor(spend/10).astype(int),
            "points_redeemed":rng.integers(0,500,n),
            "partner":rng.choice(["Internal","Bank Rewards","Retail Partner"],n)
        })

    def digital_chunk(start,n):
        return pd.DataFrame({
            "event_id":[f"DE{start+i+1:012d}" for i in range(n)],
            "event_ts":dt_random(rng,n,date_start,date_end),
            "user_token":[hashlib.sha256(f"U{start+i}".encode()).hexdigest()[:20] for i in range(n)],
            "event_name":rng.choice(["app_open","station_search","fuel_payment","shop_payment","voucher_view","loyalty_view","receipt_view"],n),
            "site_id":rng.choice(site_ids,n),
            "device_os":rng.choice(["Android","iOS"],n,p=[.76,.24]),
            "success_flag":rng.random(n)<.985
        })

    def ev_chunk(start,n):
        kwh=rng.gamma(2.1,12,n).clip(1,100); rate=rng.uniform(3,9,n)
        return pd.DataFrame({
            "charging_session_id":[f"EV{start+i+1:011d}" for i in range(n)],
            "start_ts":dt_random(rng,n,date_start,date_end),
            "site_id":rng.choice(site_ids,n),
            "kwh_delivered":kwh.round(3),
            "duration_minutes":rng.gamma(2.0,22,n).clip(4,240).round(1),
            "revenue_lcy":(kwh*rate).round(2),
            "charger_type":rng.choice(["AC","DC Fast","DC Ultra"],n,p=[.25,.6,.15])
        })

    def solar_chunk(start,n):
        return pd.DataFrame({
            "solar_reading_id":[f"SO{start+i+1:012d}" for i in range(n)],
            "reading_ts":dt_random(rng,n,date_start,date_end),
            "site_id":rng.choice(site_ids,n),
            "generation_kwh":rng.gamma(2.3,20,n).round(3),
            "site_consumption_kwh":rng.gamma(2.8,25,n).round(3),
            "grid_import_kwh":rng.gamma(2.0,18,n).round(3)
        })

    def maintenance_chunk(start,n):
        opened=dt_random(rng,n,date_start,date_end)
        downtime=rng.gamma(1.8,4.5,n).clip(0,120)
        return pd.DataFrame({
            "work_order_id":[f"WO{start+i+1:010d}" for i in range(n)],
            "opened_ts":opened,
            "asset_id":rng.choice(asset_ids,n),
            "maintenance_type":rng.choice(["Preventive","Corrective","Inspection","Calibration"],n),
            "failure_mode":rng.choice(["Leak","Electrical","Mechanical","Sensor","Software","Wear","None"],n),
            "downtime_hours":downtime.round(2),
            "maintenance_cost_lcy":rng.lognormal(7.5,1.1,n).clip(100,500000).round(2),
            "status":rng.choice(["Closed","Open","Awaiting Parts"],n,p=[.88,.08,.04])
        })

    def hsseq_chunk(start,n):
        return pd.DataFrame({
            "incident_id":[f"HS{start+i+1:010d}" for i in range(n)],
            "incident_ts":dt_random(rng,n,date_start,date_end),
            "site_id":rng.choice(site_ids,n),
            "incident_type":rng.choice(["Near Miss","First Aid","Medical Treatment","Lost Time","Spill","Vehicle","Fire"],n,
                                       p=[.45,.20,.10,.05,.09,.08,.03]),
            "severity":rng.choice(["Low","Medium","High","Critical"],n,p=[.62,.27,.09,.02]),
            "lost_time_days":rng.choice([0,0,0,0,1,2,3,5,10,20],n),
            "environmental_release_litres":np.where(rng.random(n)<.08,rng.gamma(2,40,n),0).round(2),
            "closed_flag":rng.random(n)<.92
        })

    makers = {
        "fact_retail_fuel_sales": ("retail", retail_chunk),
        "fact_shop_sales": ("shop", shop_chunk),
        "fact_commercial_orders": ("commercial", commercial_chunk),
        "fact_inventory_snapshot": ("inventory", inventory_chunk),
        "fact_deliveries": ("deliveries", delivery_chunk),
        "fact_procurement_receipts": ("procurement", procurement_chunk),
        "fact_aviation_sales": ("aviation", aviation_chunk),
        "fact_marine_sales": ("marine", marine_chunk),
        "fact_lpg_sales": ("lpg", lpg_chunk),
        "fact_lubricant_sales": ("lubes", lube_chunk),
        "fact_loyalty_transactions": ("loyalty", loyalty_chunk),
        "fact_digital_events": ("digital", digital_chunk),
        "fact_ev_charging_sessions": ("ev", ev_chunk),
        "fact_solar_generation": ("solar", solar_chunk),
        "fact_maintenance_work_orders": ("maintenance", maintenance_chunk),
        "fact_hsseq_incidents": ("hsseq", hsseq_chunk),
    }

    manifest = []
    for table, (key, fn) in makers.items():
        total = cfg[key]
        print(f"Generating {table}: {total:,}")
        write_fact_chunks(fn, total, out, table, fmt)
        manifest.append((table,total))

    pd.DataFrame(manifest,columns=["table_name","row_count"]).to_csv(out/"manifest.csv",index=False)
    print("Done.")
    print(f"Fact rows: {sum(x[1] for x in manifest):,}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", default="synthetic_output")
    parser.add_argument("--scale", choices=SCALES.keys(), default="demo")
    parser.add_argument("--format", choices=["csv","parquet"], default="parquet")
    parser.add_argument("--seed", type=int, default=42)
    args = parser.parse_args()
    generate(args.scale, args.output, args.format, args.seed)
